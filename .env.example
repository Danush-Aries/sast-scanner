# Copy this file to .env and fill in the values before running the scanner.
# Never commit your real .env file to version control.

# Required: Anthropic API key for AI-powered explanations.
# Obtain yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Set to "true" to skip AI explanations entirely (useful for CI or
# environments where the Anthropic API is unavailable).
# DISABLE_AI_EXPLAINER=false
